# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Admin / Service Role (Usado em Server API e Webhooks)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gateway de Pagamento Simplificado - Asaas
# Chave de API gerada no painel do Asaas (Sandbox ou Produção, inicia com $aact_...)
ASAAS_API_KEY=
# Ambiente: 'sandbox' para testes ou 'production' para produção real
ASAAS_ENVIRONMENT=sandbox
# Token secreto de autenticação configurado na fila de webhooks do Asaas (enviado no header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=

# Automações n8n (Opcional)
N8N_BASE_URL=
